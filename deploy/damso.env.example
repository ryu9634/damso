# 서버의 /etc/damso/damso.env 로 복사해서 사용한다.
#
#   sudo install -m 600 -o root -g damso damso.env.example /etc/damso/damso.env
#   sudo nano /etc/damso/damso.env
#
# 권한은 반드시 600 이어야 한다. 이 파일에만 자격증명이 있고, git 과 GitHub Secrets 에는 넣지 않는다.
# 값을 바꾼 뒤에는 `sudo systemctl restart damso` 로 적용한다.

# ── 데이터베이스 ──────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=damso
DB_USER=damso
# provision.sh 가 자동 생성한 값이 들어간다. 직접 넣을 때는 충분히 긴 무작위 문자열을 쓸 것.
DB_PASSWORD=

# ── 개인정보 암호화 키 ────────────────────────────────────
# 휴대폰번호·실명·연락처는 DB 에 암호화해서 저장된다. 키는 아래 둘 중 하나.
#   · 비워 두면 /var/lib/damso/damso.key 를 쓴다. 없으면 첫 부팅 때 자동 생성된다. (기본)
#   · 직접 관리하려면 32바이트를 base64 로 넣는다:  openssl rand -base64 32
# 어느 쪽이든 키를 잃으면 저장된 개인정보를 되돌릴 수 없다. backup.sh 가 키 파일도 같이 보관한다.
DAMSO_DATA_KEY=

# ── 파일 저장 위치 ────────────────────────────────────────
# 배포는 /opt/damso 아래를 통째로 교체하므로, 업로드 사진은 반드시 그 바깥에 둔다.
DAMSO_UPLOADS=/var/lib/damso/uploads

# ── JVM ───────────────────────────────────────────────────
# 컨테이너가 아닌 VPS 이므로 최대 힙을 명시한다. 2GB RAM 서버 기준값.
JAVA_OPTS="-Xms256m -Xmx768m -XX:+UseSerialGC"

# ── 간편로그인 (미발급이면 비워 둔다 — 앱에서 해당 버튼이 숨겨진다) ──
# 콘솔에 등록할 콜백 주소는 앱 화면 경로다. /api/... 가 아니다.
#     https://<도메인>/oauth/kakao
#     https://<도메인>/oauth/naver
# REDIRECT_URI 를 비워 두면 서버가 요청이 들어온 도메인 기준으로 위 주소를 만들어 쓴다.
# 도메인이 하나뿐이면 비워 두는 편이 안전하다 — 도메인이 바뀌어도 따라간다.
# 카카오는 REST API 키가 CLIENT_ID 다. (JavaScript 키가 아니다)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=