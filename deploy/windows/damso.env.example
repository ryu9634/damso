# 윈도우 PC 의 C:\damso\damso.env 로 복사해서 쓴다.
#
#   copy damso.env.example C:\damso\damso.env
#   notepad C:\damso\damso.env
#
# 이 파일에만 자격증명이 있다. git 에도 GitHub Secrets 에도 넣지 않는다.
# 값을 바꾼 뒤에는 작업 스케줄러에서 damso 작업을 다시 시작해야 적용된다
# (또는  powershell -File C:\damso\bin\restart-damso.ps1 ).
#
# 경로는 역슬래시(\) 대신 슬래시(/)로 쓴다. JDBC URL 과 자바가 둘 다 이해하는 쪽이다.

# ── 데이터 위치 ───────────────────────────────────────────
# H2 파일 DB 의 경로 접두사. ".mv.db" 는 붙이지 않는다.
#   C:/damso/data/damso  →  실제 파일은 C:\damso\data\damso.mv.db
DAMSO_DB=C:/damso/data/damso

# 업로드된 소개팅 사진. 앱 업데이트는 C:\damso\app 만 바꾸므로 그 바깥에 둔다.
DAMSO_UPLOADS=C:/damso/uploads

# 로그 파일. 콘솔 없이 백그라운드로 도는 서비스라 문제가 생기면 여기가 유일한 단서다.
DAMSO_LOG=C:/damso/logs/damso.log

# ── 개인정보 암호화 키 ────────────────────────────────────
# 휴대폰번호·실명·연락처는 DB 에 암호화해서 저장된다.
# AWS 에서 가져온 키를 C:\damso\data\damso.key 에 그대로 놓아야 기존 데이터가 읽힌다.
# 파일이 없으면 앱이 새 키를 만들어 버리고, 그러면 기존 개인정보는 영구히 못 읽는다.
# 백업(backup.ps1)이 이 키를 DB 와 함께 보관한다.
DAMSO_DATA_KEY_FILE=C:/damso/data/damso.key
# 키를 파일 대신 값으로 직접 관리하려면 여기에 base64 32바이트를 넣는다. 비워 두면 위 파일을 쓴다.
DAMSO_DATA_KEY=

# ── 네트워크 ──────────────────────────────────────────────
# cloudflared 가 같은 PC 에서 127.0.0.1 로 붙는다. 공유기 포트포워딩은 하지 않는다.
SERVER_PORT=8080
# LAN 의 다른 기기에서 직접 확인해야 할 때만 0.0.0.0 으로 잠시 바꾼다.
DAMSO_BIND=127.0.0.1

# ── JVM ───────────────────────────────────────────────────
# 집 PC 는 메모리가 넉넉하므로 VPS 기준값(768m)보다 여유를 준다.
# UseSerialGC 는 코어를 적게 쓰는 대신 이 정도 부하에서는 충분하다.
JAVA_OPTS=-Xms256m -Xmx1024m -XX:+UseSerialGC -Dfile.encoding=UTF-8

# ── 간편로그인 (미발급이면 비워 둔다 — 앱에서 해당 버튼이 숨겨진다) ──
# 도메인이 그대로면 카카오·네이버 콘솔을 고칠 필요가 없다.
# REDIRECT_URI 를 비워 두면 서버가 요청이 들어온 도메인 기준으로 콜백 주소를 만든다.
# 카카오는 REST API 키가 CLIENT_ID 다. (JavaScript 키가 아니다)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=

# ── 백업 ──────────────────────────────────────────────────
# 백업을 둘 곳. 같은 디스크에만 있는 백업은 디스크가 죽는 순간 같이 사라진다.
BACKUP_DIR=C:/damso/backups
# 며칠 치를 남길지.
BACKUP_RETENTION_DAYS=14
# 두 번째 사본을 둘 곳 — 외장 하드, NAS, OneDrive/Google Drive 동기화 폴더 중 무엇이든.
# 비워 두면 같은 PC 에만 남는다. 반드시 채우기를 권한다.
BACKUP_MIRROR=

# ── 업데이트 ──────────────────────────────────────────────
# update.ps1 이 새 jar 을 받아올 GitHub 저장소. (소유자/저장소)
GITHUB_REPO=ryu9634/damso
# 비공개 저장소라면 읽기 권한 토큰이 필요하다. 공개 저장소는 비워 둔다.
GITHUB_TOKEN=
